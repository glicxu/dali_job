# Provider credentials remain server-side.
OPENAI_API_KEY=
APIFY_API_TOKEN=

# Optional when the imported common [smtp] section already supplies a password.
# This environment value takes precedence over [smtp].password.
DALIJOB_SMTP_PASSWORD=

# Optional environment overrides for the non-secret email settings in config.ini.
DALIJOB_EMAIL_DELIVERY_MODE=
DALIJOB_EMAIL_FROM=
DALIJOB_SMTP_HOST=
DALIJOB_SMTP_PORT=
DALIJOB_SMTP_USERNAME=
DALIJOB_SMTP_USE_TLS=
DALIJOB_PUBLIC_CLIENT_URL=
DALIJOB_MOBILE_ACCESS_TOKEN_SECONDS=
DALIJOB_MOBILE_REFRESH_TOKEN_SECONDS=
