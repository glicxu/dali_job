{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "phase5-ranking-annotation.v1",
  "title": "Phase 5 ranking annotation",
  "type": "object",
  "additionalProperties": false,
  "required": ["ranking_id", "adjudication_kind", "reviewer_rankings", "entries"],
  "properties": {
    "ranking_id": {"type": "string", "minLength": 1, "maxLength": 160},
    "job_snapshot_id": {"type": ["string", "null"], "maxLength": 64},
    "adjudication_kind": {"enum": ["synthetic_architecture_fixture", "human_adjudicated"]},
    "reviewer_rankings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["reviewer_ref", "ordered_case_groups"],
        "properties": {
          "reviewer_ref": {"type": "string", "minLength": 1, "maxLength": 100},
          "ordered_case_groups": {
            "type": "array",
            "minItems": 2,
            "items": {
              "type": "array",
              "minItems": 1,
              "items": {"type": "string", "minLength": 1}
            }
          }
        }
      }
    },
    "entries": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["case_id", "adjudicated_rank", "human_score"],
        "properties": {
          "case_id": {"type": "string", "minLength": 1},
          "adjudicated_rank": {"type": "integer", "minimum": 1},
          "human_score": {"type": "number", "minimum": 0, "maximum": 100}
        }
      }
    },
    "adjudication_notes": {"type": "string", "maxLength": 4000}
  }
}
